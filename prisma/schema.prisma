generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ATTENDANT
}

enum ProductCategory {
  WHOLE_CAKE
  CAKE_SLICE
  SWEET
  EXTRA
  CUSTOM
}

enum OrderSource {
  INTERNAL
  CUSTOMER_PORTAL
}

enum OrderStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  PENDING
  IN_PRODUCTION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  PIX
  CARD
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}

model Store {
  id                  String                 @id @default(cuid())
  name                String
  publicSlug          String                 @unique
  logoUrl             String?
  phone               String?
  whatsapp            String?
  address             String?
  onlineOrdersEnabled Boolean                @default(true)
  pickupEnabled       Boolean                @default(true)
  deliveryEnabled     Boolean                @default(false)
  monthlyOrderLimit   Int?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  blockedDates        BlockedDate[]
  customers           Customer[]
  financials          FinancialTransaction[]
  orders              Order[]
  products            Product[]
  schedules           StoreSchedule[]
  users               User[]
}

model User {
  id           String   @id @default(cuid())
  storeId      String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ATTENDANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  phone     String
  whatsapp  String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@unique([storeId, phone])
  @@index([storeId, name])
}

model Product {
  id                 String          @id @default(cuid())
  storeId            String
  name               String
  category           ProductCategory
  description        String?
  basePrice          Decimal         @db.Decimal(10, 2)
  cost               Decimal?        @db.Decimal(10, 2)
  preparationHours   Int?
  active             Boolean         @default(true)
  availableOnline    Boolean         @default(true)
  imageUrl           String?
  minOrderNoticeDays Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  orderItems         OrderItem[]
  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, category])
  @@index([storeId, active, availableOnline])
}

model Order {
  id                 String          @id @default(cuid())
  storeId            String
  customerId         String?
  code               String
  source             OrderSource     @default(INTERNAL)
  status             OrderStatus     @default(AWAITING_CONFIRMATION)
  fulfillmentType    FulfillmentType @default(PICKUP)
  orderedAt          DateTime        @default(now())
  deliveryDate       DateTime?
  deliveryTime       String?
  customerName       String
  customerPhone      String
  deliveryAddress    String?
  customerNotes      String?
  internalNotes      String?
  urgent             Boolean         @default(false)
  paymentMethod      PaymentMethod?
  totalAmount        Decimal         @default(0) @db.Decimal(10, 2)
  signalPaid         Boolean         @default(false)
  signalAmount       Decimal?        @db.Decimal(10, 2)
  publicTrackingCode String          @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, deliveryDate])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  productId          String
  productName        String
  quantity           Int      @default(1)
  unitPrice          Decimal  @db.Decimal(10, 2)
  totalPrice         Decimal  @db.Decimal(10, 2)
  customizationNotes String?
  createdAt          DateTime @default(now())
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model FinancialTransaction {
  id          String                   @id @default(cuid())
  storeId     String
  type        FinancialTransactionType
  amount      Decimal                  @db.Decimal(10, 2)
  date        DateTime
  description String
  orderId     String?
  createdAt   DateTime                 @default(now())
  store       Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, date])
  @@index([storeId, type])
}

model StoreSchedule {
  id            String   @id @default(cuid())
  storeId       String
  weekday       Int
  opensAt       String?
  closesAt      String?
  acceptsOrders Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekday])
}

model BlockedDate {
  id        String   @id @default(cuid())
  storeId   String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
}
